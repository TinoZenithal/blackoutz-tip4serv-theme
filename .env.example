# Server-only Tip4Serv catalogue settings. Never prefix these with NEXT_PUBLIC_.
TIP4SERV_API_KEY=
# Optional. Keep the official URL unless Tip4Serv instructs you to use another API host.
TIP4SERV_API_BASE=https://api.tip4serv.com/v1
# Optional legacy overrides used by server-side diagnostics. The live storefront uses store 21207 and Tip4Serv's public checkout endpoint.
TIP4SERV_STORE_ID=
# Public storefront URL used for Tip4Serv's success, canceled and pending redirects.
SITE_URL=http://localhost:3000
# Optional fallback product-ID overrides. Live API products use their Tip4Serv IDs directly.
TIP4SERV_PRODUCT_BUILDING_SHED=
TIP4SERV_PRODUCT_WEAPON_WORKBENCH=
TIP4SERV_PRODUCT_PRIORITY_QUEUE=
TIP4SERV_PRODUCT_ZONE_ALERT=
TIP4SERV_PRODUCT_BACK_HATCH=
TIP4SERV_PRODUCT_PREBUILT_BASE=
TIP4SERV_PRODUCT_CUSTOM_BASE=
TIP4SERV_PRODUCT_CREDITS_75K=
TIP4SERV_PRODUCT_CREDITS_180K=
TIP4SERV_PRODUCT_CREDITS_300K=
TIP4SERV_PRODUCT_DONATION=

